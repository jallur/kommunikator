# Copy to .env next to docker-compose.yml. Never commit the real file.
# The xAI API key stays in this relay. Devices never see it.

# Container listen port. Host is always 0.0.0.0. Default 8090.
PORT=8090

XAI_API_KEY=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_MODEL=grok-voice-latest
XAI_VOICE=eve
XAI_INPUT_RATE=16000
XAI_OUTPUT_RATE=24000
XAI_REASONING_EFFORT=none

# Comma-separated device tokens. One token per Stick. Empty rejects every device.
DEVICE_TOKENS=

# TODO: Grok Bot webhook. Leave empty. The route stays 501 until CoreIT
# confirms the URL and payload. The relay does not call any guessed endpoint.
GROK_BOT_WEBHOOK_URL=
